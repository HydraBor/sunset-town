---
import Layout from "../layouts/Layout.astro";
import { site, features, roadmap, firstWeek, corePrinciples } from "../data/site";
---

<Layout title={`${site.name} — Minecraft 生存服务器`} description={`${site.name}，一个强调生存、经济、家园与社交的 Minecraft 生存服务器，当前版本 ${site.version}。`}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-night-800 via-night-900 to-night-900"></div>
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full bg-dusk-500/20 blur-3xl"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-24 text-center">
      <p class="text-dusk-300 tracking-widest text-sm mb-6 uppercase">Minecraft 生存服务器</p>
      <h1 class="text-5xl md:text-7xl font-bold text-dusk-50 mb-4 drop-shadow-glow">
        落日小镇
      </h1>
      <p class="text-slate-300 text-lg md:text-xl mb-8">
        在黄昏小镇里，从第一棵树开始，建立属于你的家园。
      </p>
      <p class="inline-block px-6 py-3 rounded-full bg-night-700 border border-dusk-500/40 text-dusk-200 mb-10">
        <span class="text-dusk-400 font-bold">{site.version}</span>
        <span class="mx-2 text-slate-500">·</span>
        <code class="text-dusk-300">{site.address}</code>
        <span class="mx-2 text-slate-500">·</span>{site.mcVersion}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/guide/" class="px-8 py-3 rounded-xl bg-gradient-to-r from-dusk-500 to-dusk-600 text-white font-bold hover:opacity-90 transition-opacity shadow-glow">
          新手入服指南
        </a>
        <a href="/worlds/" class="px-8 py-3 rounded-xl bg-night-700 border border-slate-500/30 text-slate-200 font-bold hover:border-dusk-400 transition-colors">
          了解六大世界
        </a>
      </div>
    </div>
  </section>

  <!-- 核心理念 -->
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="rounded-2xl bg-night-800/70 border border-night-600/50 p-8">
      <h2 class="text-2xl font-bold text-dusk-200 mb-6 text-center">我们的理念</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          corePrinciples.map((p) => (
            <p class="flex gap-3 items-start text-slate-300 text-sm leading-relaxed">
              <span class="text-dusk-400 mt-0.5">✦</span>
              {p}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 特色玩法 -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center text-dusk-50 mb-2">特色玩法</h2>
    <p class="text-center text-slate-400 mb-12">{site.slogan}</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        features.map((f) => (
          <article class="rounded-2xl bg-night-800/70 border border-night-600/50 p-6 hover:border-dusk-500/40 hover:shadow-glow transition-all">
            <span class="text-4xl">{f.icon}</span>
            <h3 class="text-lg font-bold text-dusk-100 mt-4 mb-2">{f.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{f.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 开荒时代首月 -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center text-dusk-50 mb-2">开荒时代 · 首月节奏</h2>
    <p class="text-center text-slate-400 mb-12">从第一周的开荒，到月底的势力形成</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        firstWeek.map((w, i) => (
          <div class="rounded-xl bg-night-800/70 border border-night-600/50 p-5 relative">
            <span class="absolute top-4 right-4 text-dusk-500/40 font-bold text-2xl">0{i + 1}</span>
            <p class="text-dusk-300 font-bold">{w.day}</p>
            <p class="text-xl font-bold text-dusk-100 mt-1 mb-3">{w.theme}</p>
            <p class="text-xs text-slate-400 mb-3">重点：{w.focus}</p>
            <p class="text-xs text-dusk-200/80">活动：{w.events}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 版本路线图 -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center text-dusk-50 mb-2">版本路线图</h2>
    <p class="text-center text-slate-400 mb-12">落日小镇的征途才刚刚开始</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        roadmap.map((r) => (
          <div class={`rounded-xl p-5 border bg-night-800/70 ${r.status === "进行中" ? "border-dusk-500/50 shadow-glow" : "border-night-600/50"}`}>
            <div class="flex items-center justify-between mb-2">
              <span class="text-dusk-400 font-bold">{r.version}</span>
              <span class={`text-xs px-2 py-0.5 rounded-full ${r.status === "进行中" ? "bg-dusk-500/20 text-dusk-300" : "bg-night-600 text-slate-400"}`}>
                {r.status}
              </span>
            </div>
            <p class="font-bold text-dusk-100 mb-1">{r.name}</p>
            <p class="text-xs text-slate-400">{r.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-4 py-16 text-center">
    <div class="rounded-3xl bg-gradient-to-br from-night-700 to-night-800 border border-dusk-500/30 p-12">
      <h2 class="text-3xl font-bold text-dusk-50 mb-4">V1.0 的最终目标不是让玩家毕业</h2>
      <p class="text-slate-300 mb-8">而是让玩家愿意继续留在小镇，等待下一个版本。</p>
      <code class="px-8 py-4 rounded-xl bg-night-900 border border-dusk-500/50 text-dusk-300 text-lg">
        {site.address}
      </code>
    </div>
  </section>
</Layout>